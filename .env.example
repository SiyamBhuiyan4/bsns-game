# Example Environment Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/marketing_performance"
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET="generate-a-secure-random-32-byte-string-here"
ADMIN_PASSWORD="ChangeThisDefaultAdminPassword123!"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Dhaka"
# Passcode for the /admin-login page
ADMIN_PASSCODE="change-this-admin-passcode"
# Required in production: bearer token for the /api/cron/* endpoints
CRON_SECRET="generate-a-secure-random-token"
